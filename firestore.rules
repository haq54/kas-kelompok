rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- fungsi bantu ----
    function masuk() { return request.auth != null; }
    function peran(k) {
      return get(/databases/$(database)/documents/groups/$(k)/akses/roles).data[request.auth.uid];
    }
    function pengurus(k) { return masuk() && peran(k) in ['host', 'bendahara']; }
    function host(k) { return masuk() && peran(k) == 'host'; }

    // ---- room: groups/{kode} ----
    match /groups/{k} {
      allow get: if true;                 // tamu cukup tahu kodenya
      allow list: if false;               // daftar semua room tidak boleh diintip

      allow create: if masuk()
        && k.matches('[A-Z0-9]{6,8}')
        && request.resource.data.pembuat == request.auth.uid
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 40;

      allow update: if host(k)
        && request.resource.data.pembuat == resource.data.pembuat
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 40;

      allow delete: if false;

      // daftar peran: {uid: 'host' | 'bendahara', label: {uid: nama}}
      match /akses/roles {
        allow get: if masuk();
        allow create: if masuk()
          && getAfter(/databases/$(database)/documents/groups/$(k)).data.pembuat == request.auth.uid
          && request.resource.data.keys().hasOnly([request.auth.uid, 'label'])
          && request.resource.data[request.auth.uid] == 'host';
        allow update: if host(k);
        allow delete: if false;
      }

      // data kas: siapa pun yang tahu kode boleh membaca, hanya pengurus yang menulis
      match /{col}/{id} {
        allow read: if col in ['members', 'pay', 'exp', 'log', 'cfg'];
        allow create, update: if col in ['members', 'pay', 'exp', 'cfg'] && pengurus(k);
        allow create: if col == 'log' && pengurus(k);          // riwayat: hanya bisa ditambah
        allow delete: if col in ['members', 'pay', 'exp'] && pengurus(k);
      }
    }

    // ---- data lama (sebelum ada room): hanya baca, untuk disalin ke room ----
    // Setelah data dipindahkan, blok ini boleh dihapus.
    match /{col}/{id} {
      allow read: if col in ['members', 'pay', 'exp', 'log', 'cfg'];
    }
  }
}
